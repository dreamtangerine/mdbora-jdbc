<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.dreamtangerine</groupId>
  <artifactId>mdbora-jdbc</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Mdbora JDBC</name>

  <description>
    Pure Java read-only JDBC driver for Microsoft Access
    MDB and ACCDB databases
  </description>

  <url>
    https://github.com/dreamtangerine/mdbora-jdbc
  </url>

  <licenses>
    <license>
      <name>Mozilla Public License 2.0</name>
      <url>https://www.mozilla.org/MPL/2.0/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>dreamtangerine</id>
      <name>Dreamtangerine</name>
      <url>https://github.com/dreamtangerine</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/dreamtangerine/mdbora-jdbc.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/dreamtangerine/mdbora-jdbc.git</developerConnection>
    <url>https://github.com/dreamtangerine/mdbora-jdbc</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/dreamtangerine/mdbora-jdbc/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <h2.version>2.4.240</h2.version>
    <jackcess.version>5.1.5</jackcess.version>
    <junit.version>5.14.1</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>

    <dependency>
      <groupId>io.github.spannm</groupId>
      <artifactId>jackcess</artifactId>
      <version>${jackcess.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>

        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>

        <configuration>
          <argLine>-Xms16m -Xmx64m</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>

        <executions>
          <execution>
            <id>attach-sources</id>

            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>

        <executions>
          <execution>
            <id>attach-javadocs</id>

            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>

        <configuration>
          <source>${maven.compiler.release}</source>
          <encoding>UTF-8</encoding>
          <docencoding>UTF-8</docencoding>
          <charset>UTF-8</charset>
        </configuration>
      </plugin>
      
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.1</version>

        <executions>
          <execution>
            <id>generate-third-party-notices</id>
            <phase>generate-resources</phase>

            <goals>
              <goal>add-third-party</goal>
              <goal>download-licenses</goal>
            </goals>
          </execution>
        </executions>

        <configuration>
          <includeTransitiveDependencies>true</includeTransitiveDependencies>
          <excludeTransitiveDependencies>false</excludeTransitiveDependencies>

          <excludedScopes>test</excludedScopes>

          <includeOptional>true</includeOptional>
          <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
          <outputDirectory>${project.build.directory}/generated-resources/licenses</outputDirectory>

          <licensesOutputDirectory>${project.build.directory}/generated-resources/licenses/dependencies</licensesOutputDirectory>

          <addOutputDirectoryAsResourceDir>true</addOutputDirectoryAsResourceDir>

          <generateBundle>true</generateBundle>

          <bundleThirdPartyPath>META-INF/mdbora-jdbc-THIRD-PARTY.txt</bundleThirdPartyPath>
        </configuration>
      </plugin>
      
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>bundle</id>

      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.2</version>

            <executions>
              <execution>
                <id>create-fat-jar</id>
                <phase>package</phase>

                <goals>
                  <goal>shade</goal>
                </goals>

                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>all</shadedClassifierName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>

                      <excludes>
                        <!-- Module descriptor for regular modular JARs. -->
                        <exclude>module-info.class</exclude>

                        <!-- Module descriptors in multi-release JARs. -->
                        <exclude>META-INF/versions/*/module-info.class</exclude>

                        <!-- Dependency manifests are not copied into the fat JAR. -->
                        <exclude>META-INF/MANIFEST.MF</exclude>

                        <!-- Signatures become invalid when the original JAR is modified. -->
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                        <exclude>META-INF/SIG-*</exclude>
                      </excludes>
                    </filter>
                  </filters>

                  <transformers>
                    <!--
                      Combina los registros ServiceLoader,
                      incluido java.sql.Driver.
                    -->
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                  </transformers>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Firma los artefactos y los sube al Central Publisher Portal.
    -->
    <profile>
      <id>release</id>

      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>

            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>

                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>

            <extensions>true</extensions>

            <configuration>
              <publishingServerId>central</publishingServerId>

              <!--
                false: sube y valida, pero debes pulsar Publish
                manualmente en Central Portal.
              -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>